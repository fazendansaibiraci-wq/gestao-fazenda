generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  FUNCIONARIO
  GERENTE
  AGRONOMO
  GESTOR
}

enum TipoSalario {
  MENSAL
  DIARIO
}

enum TalhaoStatus {
  ATIVO
  INATIVO
  PREPARACAO
  COLHEITA
}

enum PerfilTalhao {
  RECEM_PLANTADO
  ESQUELETADO
  PLENA_PRODUCAO
}

enum MaquinaStatus {
  ATIVA
  MANUTENCAO
  INATIVA
}

enum SafraStatus {
  ATIVA
  ENCERRADA
}

// Regime salarial: independente da entidade Safra (ciclo agronômico, com
// talhões/insumos/etc — ver model Safra). Usado pelo model
// PeriodoRegimeSalarial (ver abaixo) pra marcar o tipo de cada período
// cadastrado.
enum RegimeSalarial {
  SAFRA
  ENTRESSAFRA
}

enum TipoAtividade {
  PULVERIZACAO
  HERBICIDA
  ADUBACAO
  COLHEITA
  CAPINA_MECANICA
  DESBROTA
  CAPINA_MANUAL
  CHEGAMENTO_TERRA
  CORRECAO_SOLO
  IRRIGACAO
  INSETICIDA_SOLO
  GERAIS
}

enum StatusRegistroAtividade {
  EM_ANDAMENTO
  CONCLUIDO
  PENDENTE
}

enum AtividadeInsumo {
  HERBICIDA
  PULVERIZACAO
  DRENCH
  ADUBACAO
  CORRECAO_SOLO
}

// Models
model User {
  id       String   @id @default(cuid())
  email    String   @unique
  password String
  name     String
  role     UserRole @default(FUNCIONARIO)
  // Rótulo mostrado no lugar do nome padrão do `role` (ex: "GERENTE" →
  // "Gerente") nas telas de Funcionários — não afeta permissão/acesso
  // nenhum, só o texto exibido. Usado quando o perfil real (que decide o
  // que a pessoa pode acessar) não reflete como ela deve aparecer pra
  // quem vê a lista (ex: Lucas Lima é cadastrado como GERENTE — mesmas
  // permissões de um gerente — mas deve aparecer como "Consultor").
  // Null = mostra o rótulo padrão do role.
  perfilExibicao String?
  phone    String?
  active   Boolean  @default(true)

  tipoSalario               TipoSalario?
  salarioEntressafra        Float?
  salarioSafra              Float?
  valorHoraExtraEntressafra Float?
  valorHoraExtraSafra       Float?
  bancoHorasAtivo           Boolean      @default(false)
  pagamentoProporcionalDiario Boolean    @default(false)
  ocultarRegistroAtividades Boolean @default(false)
  // Desliga pra quem não deve entrar em nenhum cálculo de folha de
  // pagamento (ex: consultores externos que não são funcionários da
  // fazenda, mesmo cadastrados com o mesmo perfil de outros que SÃO —
  // ver caso do Lucas Lima). Quando false, a pessoa some das abas
  // Salário Safra/Entressafra, do Resumo Mensal, do Painel Financeiro e
  // do custo HH/HM. Não depende do campo `role` — pessoas com o mesmo
  // perfil podem ter valores diferentes aqui (ex: Jair é GERENTE e
  // participa normalmente; Lucas também é GERENTE mas não participa).
  participaFolhaPagamento Boolean @default(true)
  cargaHorariaSafra         Float?
  cargaHorariaSegSex        Float?
  cargaHorariaSabado        Float?
  cargaHorariaDomingo       Float?
domingosPorMes        Int?   @default(2)
  escalasEntressafra  EscalaEntressafra[]
  escalasAfra         EscalaSafra[]
  registrosAtividade  RegistroAtividade[]
  diariasTurmaCriadas DiariaTurma[]
  bancoHoras          BancoHoras?
  aprovacoesPendentes AprovacaoHoraExtra[]

  conferenciasEstoque ConferenciaEstoque[]
  saidasProdutoRegistradas SaidaProduto[]
  ajustesEstoqueRegistrados AjusteEstoque[]
  entradasProdutoRegistradas EntradaProduto[]
  ajustesHorimetroRegistrados AjusteHorimetro[]
  transferenciasEstoqueRegistradas TransferenciaEstoque[]

  receitasCriadas  ReceitaBase[]     @relation("ReceitaBaseCriador")
  ajustesReceita   AjusteReceita[]
  aplicacoesInsumo AplicacaoInsumo[]
  aplicacaoInsumoItens AplicacaoInsumoItem[]

  etapasTerreiro      EtapaTerreiro[]
  etapasSecador       EtapaSecador[]
  etapasTulha         EtapaTulha[]
  etapasBeneficio     EtapaBeneficio[]
  etapasClassificacao EtapaClassificacao[]
  etapasSilo          EtapaSilo[]
  etapasArmazem       EtapaArmazem[]

  valesRecebidos Vale[] @relation("ValesRecebidos")
  valesLancados  Vale[] @relation("ValesLancados")

  chatSessions  AssistantChat[]
  assistantLogs AssistantLog[]

  salariosPeriodo SalarioPeriodo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model EscalaEntressafra {
  id                    String  @id @default(cuid())
  funcionario           User    @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId         String
  diaSemana             Int
  horarioEntrada        String
  horarioSaida          String
  intervaloAlmocoInicio String?
  intervaloAlmocoFim    String?

  @@unique([funcionarioId, diaSemana])
  @@map("escalas_entressafra")
}

model EscalaSafra {
  id                    String   @id @default(cuid())
  funcionario           User     @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId         String
  data                  DateTime
  horarioEntrada        String
  horarioSaida          String
  intervaloAlmocoInicio String?
  intervaloAlmocoFim    String?
  ehFeriado             Boolean  @default(false)

  @@unique([funcionarioId, data])
  @@map("escalas_safra")
}

model BancoHoras {
  id               String @id @default(cuid())
  funcionario      User   @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId    String @unique
  saldoHoras       Float  @default(0)
  mes              Int
  ano              Int
  saldoAnterior    Float  @default(0)
  horasAdicionadas Float  @default(0)
  horasAbatidas    Float  @default(0)

  ultimaAtualizacao DateTime @updatedAt

  @@unique([funcionarioId, mes, ano])
  @@map("banco_horas")
}

model AprovacaoHoraExtra {
  id            String  @id @default(cuid())
  funcionario   User    @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String
  registroId    String
  horasExtras   Float
  status        String  @default("pendente")
  observacao    String?

  criadoEm   DateTime  @default(now())
  aprovadoEm DateTime?

  @@map("aprovacoes_hora_extra")
}

model Talhao {
  id                String       @id @default(cuid())
  nome              String
  area              Float?
  variedade         String?
  status            TalhaoStatus @default(ATIVO)
  dataCriacao       DateTime     @default(now())
  ultimaAtualizacao DateTime     @updatedAt

  talfaoSafra        TalhaoSafra[]
  registrosAtividade RegistroAtividade[]
  diariasTurma        DiariaTurma[]
  chegadasTerreiro   ChegadaTerreiro[]
  aplicacoesInsumo   AplicacaoInsumo[]
  historicoAplicacao HistoricoAplicacao[]
  aplicacaoInsumoItens AplicacaoInsumoItem[]
  saidasProduto      SaidaProduto[]
  abastecimentos     AbastecimentoTrator[]

  @@map("talhoes")
}

model TalhaoSafra {
  id       String       @id @default(cuid())
  talhao   Talhao       @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId String
  safra    Safra        @relation(fields: [safraId], references: [id], onDelete: Cascade)
  safraId  String
  perfil   PerfilTalhao

  @@unique([talhaoId, safraId])
  @@map("talhao_safra")
}

model Maquina {
  id                String        @id @default(cuid())
  nome              String
  tipo              String
  marca             String?
  modelo            String?
  ano               Int?
  placa             String?
  valor             Float?
  valorResidual     Float?
  vidaUtilHoras     Float?
  status            MaquinaStatus @default(ATIVA)
  ultimoHorimetro   Float         @default(0)
  dataCriacao       DateTime      @default(now())
  ultimaAtualizacao DateTime      @updatedAt

  registrosAtividade RegistroAtividade[]
  registrosAtividadeMaquinaExtra RegistroAtividadeMaquina[]
  abastecimentos     AbastecimentoTrator[] @relation("AbastecimentoTrator")
  ajustesHorimetro   AjusteHorimetro[]

  @@map("maquinas")
}

model Produto {
  id                String   @id @default(cuid())
  nomeComercial     String
  categoria         String
  unidadeMedida     String
  valorUnitario     Float
  fornecedor        String?
  status            Boolean  @default(true)
  quantidadeEstoque Float    @default(0)
  estoqueMinimo     Float    @default(0)
  dataCriacao       DateTime @default(now())
  ultimaAtualizacao DateTime @updatedAt

  receitas          Receita[]
  produtosAplicacao ProdutoAplicacao[]
  produtosReceita   ProdutoReceita[] @relation("ProdutoReceitaBase")
  ajustes           AjusteReceita[]  @relation("AjusteReceitaProduto")
  saidas            SaidaProduto[]
  ajustesEstoque     AjusteEstoque[]
  entradas           EntradaProduto[]
  aplicacaoInsumoItens AplicacaoInsumoItem[]
  estoqueLocais EstoqueLocal[]
  transferencias TransferenciaEstoque[]

  @@map("produtos")
}

model Local {
  id        String   @id @default(cuid())
  nome      String   @unique
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  estoques  EstoqueLocal[]
  saidas         SaidaProduto[]
  ajustesEstoque AjusteEstoque[]
  transferenciasOrigem  TransferenciaEstoque[] @relation("TransferenciaOrigem")
  transferenciasDestino TransferenciaEstoque[] @relation("TransferenciaDestino")

  @@map("locais")
}

model TransferenciaEstoque {
  id             String   @id @default(cuid())
  produto        Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId      String
  localOrigem    Local    @relation("TransferenciaOrigem", fields: [localOrigemId], references: [id])
  localOrigemId  String
  localDestino   Local    @relation("TransferenciaDestino", fields: [localDestinoId], references: [id])
  localDestinoId String
  quantidade     Float
  data           DateTime
  observacao     String?
  registradoPor      User   @relation(fields: [registradoPorId], references: [id])
  registradoPorId    String

  dataCriacao DateTime @default(now())

  @@index([produtoId])
  @@map("transferencias_estoque")
}

model EstoqueLocal {
  id         String   @id @default(cuid())
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId  String
  local      Local    @relation(fields: [localId], references: [id])
  localId    String
  quantidade Float    @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([produtoId, localId])
  @@index([produtoId])
  @@map("estoque_locais")
}

model SaidaProduto {
  id              String   @id @default(cuid())
  produto         Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId       String
  quantidade      Float
  data            DateTime
  talhao          Talhao?  @relation(fields: [talhaoId], references: [id])
  talhaoId        String?
  safra           Safra?   @relation(fields: [safraId], references: [id])
  safraId         String?
  observacao      String?
  registradoPor   User     @relation(fields: [registradoPorId], references: [id])
  registradoPorId String
  local           Local?   @relation(fields: [localId], references: [id])
  localId         String?

  dataCriacao DateTime @default(now())

  abastecimento AbastecimentoTrator?

  @@index([produtoId])
  @@index([talhaoId])
  @@map("saidas_produto")
}

model AjusteEstoque {
  id                 String   @id @default(cuid())
  produto            Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId          String
  quantidadeAnterior Float
  quantidadeNova     Float
  diferenca          Float
  data               DateTime
  observacao         String
  registradoPor      User     @relation(fields: [registradoPorId], references: [id])
  registradoPorId    String
  local              Local?   @relation(fields: [localId], references: [id])
  localId            String?

  dataCriacao DateTime @default(now())

  @@index([produtoId])
  @@map("ajustes_estoque")
}

model AjusteHorimetro {
  id                String   @id @default(cuid())
  maquina           Maquina  @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  maquinaId         String
  horimetroAnterior Float
  horimetroNovo     Float
  data              DateTime
  observacao        String
  registradoPor     User     @relation(fields: [registradoPorId], references: [id])
  registradoPorId   String

  dataCriacao DateTime @default(now())

  @@index([maquinaId])
  @@map("ajustes_horimetro")
}

model EntradaProduto {
  id              String   @id @default(cuid())
  produto         Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId       String
  quantidade      Float
  valorUnitario   Float
  data            DateTime
  numeroNota      String?
  serieNota       String?
  fornecedor      String?
  chaveAcesso     String?
  registradoPor   User     @relation(fields: [registradoPorId], references: [id])
  registradoPorId String

  dataCriacao DateTime @default(now())

  @@index([produtoId])
  @@map("entradas_produto")
}


model Receita {
  id           String       @id @default(cuid())
  produto      Produto      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId    String
  safra        Safra        @relation(fields: [safraId], references: [id], onDelete: Cascade)
  safraId      String
  perfilTalhao PerfilTalhao
  dosagem      Float
  unidade      String
  tipo         String

  @@unique([produtoId, safraId, perfilTalhao, tipo])
  @@map("receitas")
}

model ReceitaAplicacao {
  id          String        @id @default(cuid())
  nome        String        @unique
  tipo        TipoAtividade
  observacoes String?
  ativo       Boolean       @default(true)

  produtosAplicacao  ProdutoAplicacao[]
  registrosAtividade RegistroAtividade[]

  dataCriacao       DateTime @default(now())
  ultimaAtualizacao DateTime @updatedAt

  @@map("receitas_aplicacao")
}

model ProdutoAplicacao {
  id        String           @id @default(cuid())
  receita   ReceitaAplicacao @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  receitaId String
  produto   Produto          @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId String
  dosagem   Float
  unidade   String

  dataCriacao DateTime @default(now())

  @@unique([receitaId, produtoId])
  @@map("produtos_aplicacao")
}

model Safra {
  id                String      @id @default(cuid())
  nome              String
  dataInicio        DateTime
  dataFim           DateTime?
  status            SafraStatus @default(ATIVA)
  dataCriacao       DateTime    @default(now())
  ultimaAtualizacao DateTime    @updatedAt

  talhaoSafra        TalhaoSafra[]
  receitas           Receita[]
  registrosAtividade RegistroAtividade[]
  diariasTurma       DiariaTurma[]
  lotes              Lote[]
  chegadasTerreiro   ChegadaTerreiro[]
  receitasBase       ReceitaBase[]        @relation("ReceitaBaseSafra")
  aplicacoes         AplicacaoInsumo[]    @relation("AplicacaoInsumoSafra")
  historico          HistoricoAplicacao[] @relation("HistoricoAplicacaoSafra")
  safraReceita       SafraReceita?        @relation("SafraReceitasRelacao")
  safraExtended      SafraExtended?
  saidasProduto      SaidaProduto[]
  abastecimentos     AbastecimentoTrator[]
  aplicacaoInsumoItens AplicacaoInsumoItem[]

  @@map("safras")
}

model RegistroAtividade {
  id                String   @id @default(cuid())
  funcionario       User     @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId     String
  data              DateTime
  horaEntrada       String
  horaSaida         String?
  horasCalculadas   Float?
  horasprevistasdia Float?

  talhao   Talhao? @relation(fields: [talhaoId], references: [id])
  talhaoId String?
  safra    Safra  @relation(fields: [safraId], references: [id])
  safraId  String

  tipoAtividade String
  status        StatusRegistroAtividade @default(PENDENTE)
  observacao    String?
  fotoEvidencia String?

  receitaAplicacao   ReceitaAplicacao? @relation(fields: [receitaAplicacaoId], references: [id], onDelete: SetNull)
  receitaAplicacaoId String?

  totalBombas         Int?
  tipoAdubo           String?
  quantidadeAdubo     Float?
  tipoCorretivo       String?
  quantidadeCorretivo Float?
  // Área feita naquele dia, em hectares — informativo, preenchido só
  // pelo Gestor (opcional). Independente da área total do talhão
  // (Talhao.area) — esse campo é o quanto foi de fato trabalhado
  // naquele registro específico.
  areaHectares        Float?

  maquina             Maquina? @relation(fields: [maquinaId], references: [id], onDelete: SetNull)
  maquinaId           String?
  horimetroInicial    Float?
  horimetroFinal      Float?
  horasMaquina        Float?
  implementoUtilizado String?
  // Máquinas ADICIONAIS usadas na mesma atividade/dia, além da máquina
  // principal acima — pra quando o funcionário troca de máquina durante
  // o dia (ex: trator A de manhã, trator B à tarde). Cada uma com seu
  // próprio horímetro. Etapa 1 (27/08/2026): só cadastro — os cálculos de
  // combustível/custo por hora-máquina/painéis ainda consideram só a
  // máquina principal, não estas.
  maquinasAdicionais  RegistroAtividadeMaquina[]
  // "Horas Não Identificadas": registro criado pela tela de reconciliação de
  // Combustível (não pelo funcionário) pra fechar um buraco de horímetro sem
  // atividade lançada. NÃO confundir com o model AjusteHorimetro (esse aqui
  // é um RegistroAtividade normal, só com essa flag e tipoAtividade fixo
  // 'AJUSTE_HORIMETRO'; AjusteHorimetro é outra feature, que corrige
  // Maquina.ultimoHorimetro direto).
  isAjusteHorimetro   Boolean  @default(false)
  passouDiretoAlmoco  Boolean @default(false)
  isFalta             Boolean @default(false)
  motivoFalta         String?
  periodoFalta        String?
  observacaoFalta     String?
  atestadoUrl         String?

  ehHoraExtra     Boolean @default(false)
  statusAprovacao String  @default("pendente")

  aplicacoesInsumo AplicacaoInsumo[]

  dataCriacao       DateTime @default(now())
  ultimaAtualizacao DateTime @updatedAt

  @@index([funcionarioId])
  @@index([data])
  @@index([status])
  @@map("registros_atividade")
}

// Máquina adicional usada na mesma atividade/dia (ver comentário em
// RegistroAtividade.maquinasAdicionais acima). Uma linha por máquina
// extra, cada uma com seu próprio horímetro — a mesma validação de
// sequência (nunca retroceder em relação ao último horímetro conhecido
// dessa máquina) vale aqui também, considerando tanto RegistroAtividade.
// maquinaId (máquina principal de qualquer registro) quanto esta tabela
// (ver lib/registroAtividadeMaquinas.ts).
model RegistroAtividadeMaquina {
  id                  String            @id @default(cuid())
  registroAtividade   RegistroAtividade @relation(fields: [registroAtividadeId], references: [id], onDelete: Cascade)
  registroAtividadeId String
  maquina             Maquina           @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  maquinaId           String
  horimetroInicial    Float
  horimetroFinal      Float
  horasMaquina        Float?
  implementoUtilizado String?
  ordem               Int               @default(0)
  dataCriacao         DateTime          @default(now())

  @@index([maquinaId])
  @@index([registroAtividadeId])
  @@map("registro_atividade_maquinas")
}

model Turma {
  id        String   @id @default(cuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  diariasTurma DiariaTurma[]

  @@map("turmas")
}

model DiariaTurma {
  id                String   @id @default(cuid())
  data              DateTime
  turma             Turma    @relation(fields: [turmaId], references: [id])
  turmaId           String
  quantidadePessoas Float

  talhao   Talhao @relation(fields: [talhaoId], references: [id])
  talhaoId String
  safra    Safra  @relation(fields: [safraId], references: [id])
  safraId  String

  tipoAtividade String
  valorDiaria   Float
  valorTotal    Float
  observacao    String?

  criadoPor   User   @relation(fields: [criadoPorId], references: [id])
  criadoPorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([data])
  @@index([talhaoId])
  @@index([turmaId])
  @@map("diarias_turma")
}

model Feriado {
  id          String   @id @default(cuid())
  data        DateTime @unique
  nome        String
  descricao   String?
  tipo        String   @default("nacional")
  dataCriacao DateTime @default(now())

  @@map("feriados")
}

model AbastecimentoTrator {
  id                String   @id @default(cuid())
  data              DateTime
  maquina           Maquina  @relation("AbastecimentoTrator", fields: [maquinaId], references: [id])
  maquinaId         String
  horimetroAtual    Float
  horimetroanterior Float?
  litrosAbastecidos Float
  valorPorLitro     Float

  horasTrabalhadad   Float?
  consumoLporH       Float?
  custoAbastecimento Float?
  consumoMedio       Float?
  alertaConsumo      Boolean @default(false)

  observacao        String?
  dataCriacao       DateTime @default(now())
  ultimaAtualizacao DateTime @updatedAt

  saidaProduto   SaidaProduto? @relation(fields: [saidaProdutoId], references: [id])
  saidaProdutoId String?       @unique

  talhao        Talhao?  @relation(fields: [talhaoId], references: [id])
  talhaoId      String?
  safra         Safra?   @relation(fields: [safraId], references: [id])
  safraId       String?
  tipoAtividade String?

  @@index([maquinaId, data])
  @@map("abastecimentos_trator")
}

model EntradaDiesel {
  id              String   @id @default(cuid())
  data            DateTime
  litrosRecebidos Float
  valorPorLitro   Float
  custoTotal      Float?
  nf              String?
  fornecedor      String?
  observacao      String?
  dataCriacao     DateTime @default(now())

  @@index([data])
  @@map("entradas_diesel")
}

model ConferenciaEstoque {
  id             String   @id @default(cuid())
  data           DateTime
  estoqueFisico  Float
  estoqueTeorico Float
  diferenca      Float?
  percentualDif  Float?
  alerta         Boolean  @default(false)

  custoMedioLitro   Float?
  custoTotalConsumo Float?

  observacao     String?
  realizadoPor   User    @relation(fields: [realizadoPorId], references: [id])
  realizadoPorId String

