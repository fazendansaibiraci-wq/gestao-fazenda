model ConfiguracaoGlobal {
  id                      String    @id @default(cuid())
  // Fallback interno (não editável diretamente na UI desde 25/08/2026) —
  // ver os 4 campos por dia da semana abaixo, que são a fonte real usada
  // no cálculo. Mantido só como valor de segurança caso algum dos 4 abaixo
  // esteja nulo.
  cargaHorariaEntressafra Float     @default(8)
  // Jornada de Entressafra: mesma pra todo mundo, por dia da semana
  // (Segunda a Quinta / Sexta / Sábado / Domingo). Sábado e Domingo não
  // são trabalhados por padrão.
  cargaHorariaEntressafraSegQui  Float? @default(9)
  cargaHorariaEntressafraSexta   Float? @default(8)
  cargaHorariaEntressafraSabado  Float? @default(0)
  cargaHorariaEntressafraDomingo Float? @default(0)
  inicioSafra             DateTime?
  fimSafra                DateTime?
  // Campo morto desde 26/08/2026 — não lido por nenhuma lógica de cálculo.
  // Era o botão manual que decidia Safra/Entressafra pro sistema inteiro;
  // substituído pelo model PeriodoRegimeSalarial (períodos com início/fim,
  // comparados dia a dia). Mantido só pra não quebrar o schema com dado
  // histórico já gravado.
  regimeSalarial          RegimeSalarial @default(ENTRESSAFRA)
  updatedAt               DateTime  @updatedAt
  lembreteTurmasTexto     String?
  lembreteTurmasAtivo     Boolean   @default(false)

  @@map("configuracao_global")
}

// Períodos de Safra/Entressafra pra cálculo de salário/hora extra/carga
// horária (independente do model Safra, que é a entidade agronômica de
// ciclo de plantio/colheita usada por talhões/insumos/aplicações — não
// mexe nesse propósito).
//
// Cadastrado em Configurações Gerais: clicar em "Safra" ou "Entressafra"
// abre um seletor de intervalo (dataInicio + dataFim) pra registrar aquele
// período. A partir de 26/08/2026 essas datas são a fonte da verdade do
// cálculo — cada dia de cada Registro de Atividade é comparado contra os
// períodos aqui cadastrados pra saber qual regime usar naquele dia
// específico (substituindo o botão manual único de ConfiguracaoGlobal.
// regimeSalarial, agora um campo morto).
//
// Períodos não podem se sobrepor entre si (nem do mesmo tipo, nem entre
// tipos diferentes) — validado na criação (ver app/api/
// periodos-regime-salarial/route.ts). Um dia que não cai em NENHUM
// período cadastrado é tratado como pendência: bloqueia lançamentos novos
// com aviso, mostra aviso pontual no Resumo Mensal, e gera alerta no cron
// de falta automática — nunca assume um regime padrão silenciosamente.
model PeriodoRegimeSalarial {
  id         String         @id @default(cuid())
  tipo       RegimeSalarial
  dataInicio DateTime
  dataFim    DateTime
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  salariosPeriodo SalarioPeriodo[]

  @@map("periodo_regime_salarial")
}

// Salário/hora extra/jornada de cada funcionário, específico de cada
// período de Safra/Entressafra cadastrado (ver PeriodoRegimeSalarial
// acima). Substitui os antigos campos fixos User.salarioSafra/
// salarioEntressafra/valorHoraExtraSafra/valorHoraExtraEntressafra/
// tipoSalario/cargaHorariaSegSex/cargaHorariaSabado/cargaHorariaDomingo/
// domingosPorMes (mantidos no schema por enquanto, mas em processo de
// migração pra este model) — cada período (mesmo repetindo o tipo, ex:
// Safra 2026 e Safra 2027) tem seu próprio valor, permitindo reajustes
// ano a ano sem sobrescrever o histórico.
// salarioMensal OU salarioDiaria é preenchido conforme o tipoSalario
// (nunca os dois). Os campos de jornada têm estrutura diferente conforme
// o tipo do período (ver PeriodoRegimeSalarial.tipo): num período SAFRA
// usa-se cargaHorariaSegSex + domingosTrabalhadosPorMes; num período
// ENTRESSAFRA usa-se cargaHorariaSegQui + cargaHorariaSexta.
// cargaHorariaSabado/cargaHorariaDomingo são usados nos dois tipos.
model SalarioPeriodo {
  id                      String                @id @default(cuid())
  funcionario             User                  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId           String
  periodo                 PeriodoRegimeSalarial @relation(fields: [periodoRegimeSalarialId], references: [id], onDelete: Cascade)
  periodoRegimeSalarialId String
  tipoSalario             TipoSalario?
  salarioMensal           Float?
  salarioDiaria           Float?
  valorHoraExtra          Float?
  cargaHorariaSegSex             Float? // Safra
  cargaHorariaSegQui             Float? // Entressafra
  cargaHorariaSexta              Float? // Entressafra
  cargaHorariaSabado             Float? // Safra e Entressafra
  cargaHorariaDomingo            Float? // Safra e Entressafra
  domingosTrabalhadosPorMes      Int?   // Safra
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@unique([funcionarioId, periodoRegimeSalarialId])
  @@map("salario_periodo")
}

